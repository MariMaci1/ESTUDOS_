function calcular(operacoes){
    let n1 = Number(document.getElementById("n1").value);
    let n2 = Number(document.getElementById("n2").value);

    let resultado
    switch(operacoes){
        case "+":resultado = somar(n1,n2);break;
        case "-":resultado = subtrair(n1,n2);break;
        case "*":resultado = multiplicar(n1,n2);break;
        case "/":resultado = dividir(n1,n2);break;
        default: "Operação inválida";
    }

    document.getElementById("resultado").innerHTML = `O Resultado é: ${resultado}`

}

function somar(n1,n2){
    return n1+n2;
}

function subtrair(n1,n2){
    return n1-n2;
}

function multiplicar(n1,n2){
    return n1*n2;
}

function dividir(n1,n2){
    if (n1 or n2 ==0){
        return "Não é possível dividir um número por zero!"
}
    return n1/n2;
}
